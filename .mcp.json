{
  "mcpServers": {
    "quizlar": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.14.3",
        "https://mcp.quizlar.app/mcp/",
        "--header",
        "Authorization:Bearer ${QUIZLAR_API_KEY}"
      ],
      "env": {
        "QUIZLAR_API_KEY": "sk-qz-replace-with-your-key"
      }
    }
  }
}
